MONGODB_URI=mongodb://localhost:27017/construction_crm
# Required — boot now fails fast if unset (fixed 2026-08-24: previously silently fell back to a
# hardcoded secret due to a module-load-ordering bug; see .ai/BE/features/production-hardening.md).
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
PORT=4000
# The legacy/default tenant's Organization.slug — every pre-multi-tenancy record already carries
# this value, so this org needs no data backfill (see .ai/BE/features/multi-tenancy.md).
DEFAULT_ORGANIZATION_ID=default
DEFAULT_ORGANIZATION_NAME=Default Organization
# Off by default — POST /auth/register 403s unless explicitly enabled. See auth.service.ts.
ALLOW_PUBLIC_REGISTRATION=false
SEED_USERS=true
SEED_DEFAULT_PASSWORD=ChangeMe123!
SEED_SUPERADMIN_EMAIL=superadmin@construction.local
SEED_SUPERADMIN_PASSWORD=ChangeMe123!
SEED_PERMISSIONS=true

# Comma-separated CORS allow-list; '*' allows any origin. Default preserves local frontend dev.
ALLOWED_ORIGINS=http://localhost:3000
# Rate limiting (@nestjs/throttler) — per-IP, in-memory (per-instance; see Known gaps).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
# MongoDB connection tuning — defaults match the driver's own defaults.
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_AUTO_INDEX=true

# Platform admin (master-admin) — a separate identity/JWT secret from org accounts, see
# .ai/BE/features/platform-admin.md. Required — boot fails fast if unset, same as JWT_SECRET.
PLATFORM_JWT_SECRET=change-me-in-production-platform
PLATFORM_JWT_EXPIRES_IN=30m
SEED_PLATFORM_ADMIN=true
PLATFORM_ADMIN_EMAIL=platform-admin@construction.local
PLATFORM_ADMIN_NAME=Platform Administrator
PLATFORM_ADMIN_PASSWORD=ChangeMe123!

# Multi-tenancy — organization signup/trial/status-cache tuning.
TRIAL_PERIOD_DAYS=14
ORG_STATUS_CACHE_TTL_MS=30000
